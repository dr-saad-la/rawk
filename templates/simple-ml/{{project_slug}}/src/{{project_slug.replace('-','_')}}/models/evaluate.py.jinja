"""Model evaluation"""

import pandas as pd
import numpy as np
from pathlib import Path
import joblib
{% if model_type == 'classification' %}
from sklearn.metrics import accuracy_score, precision_score, recall_score, f1_score, classification_report, confusion_matrix
{% elif model_type == 'regression' %}
from sklearn.metrics import mean_squared_error, mean_absolute_error, r2_score
{% endif %}
{% if use_hydra %}
import hydra
from omegaconf import DictConfig
{% endif %}
{% if use_wandb %}
import wandb
{% endif %}


def evaluate_model(model, X_test: pd.DataFrame, y_test: pd.Series) -> dict:
    """Evaluate model performance

    Args:
        model: Trained model
        X_test: Test features
        y_test: Test labels

    Returns:
        Dictionary of metrics
    """
    print("📈 Evaluating model...")

    # Make predictions
    y_pred = model.predict(X_test)

    {% if model_type == 'classification' %}
    # Calculate metrics
    metrics = {
        "accuracy": accuracy_score(y_test, y_pred),
        "precision": precision_score(y_test, y_pred, average="weighted"),
        "recall": recall_score(y_test, y_pred, average="weighted"),
        "f1_score": f1_score(y_test, y_pred, average="weighted"),
    }

    print("\n📊 Classification Report:")
    print(classification_report(y_test, y_pred))

    {% elif model_type == 'regression' %}
    # Calculate metrics
    metrics = {
        "mse": mean_squared_error(y_test, y_pred),
        "rmse": np.sqrt(mean_squared_error(y_test, y_pred)),
        "mae": mean_absolute_error(y_test, y_pred),
        "r2_score": r2_score(y_test, y_pred),
    }
    {% endif %}

    # Print metrics
    print("\n📊 Metrics:")
    for metric_name, metric_value in metrics.items():
        print(f"  {metric_name}: {metric_value:.4f}")

    return metrics


{% if use_hydra %}
@hydra.main(version_base=None, config_path="../../configs", config_name="config")
def main(cfg: DictConfig) -> None:
    """Main evaluation pipeline"""
    print("🎸 Starting evaluation...")

    {% if use_wandb %}
    # Initialize W&B
    wandb.init(project="{{ project_slug }}", job_type="evaluation")
    {% endif %}

    # Load model
    model = joblib.load(cfg.model.save_path)

    # Load test data
    X_test = pd.read_parquet(cfg.data.processed_path + "/X_test.parquet")
    y_test = pd.read_parquet(cfg.data.processed_path + "/y_test.parquet")["target"]

    # Evaluate
    metrics = evaluate_model(model, X_test, y_test)

    {% if use_wandb %}
    # Log metrics
    wandb.log(metrics)
    wandb.finish()
    {% endif %}

    print("✓ Evaluation complete!")
