def scale_features(X: pd.DataFrame, scaler=None) -> tuple[pd.DataFrame, StandardScaler]:
    """Scale features using StandardScaler

    Args:
        X: Input features
        scaler: Pre-fitted scaler (optional)

    Returns:
        Tuple of (scaled features, fitted scaler)
    """
    if scaler is None:
        scaler = StandardScaler()
        X_scaled = pd.DataFrame(
            scaler.fit_transform(X),
            columns=X.columns,
            index=X.index
        )
    else:
        X_scaled = pd.DataFrame(
            scaler.transform(X),
            columns=X.columns,
            index=X.index
        )

    return X_scaled, scaler
