def train_model(
    X_train: pd.DataFrame,
    y_train: pd.Series,
    model_type: str = "random_forest",
    **model_params
):
    """Train ML model

    Args:
        X_train: Training features
        y_train: Training labels
        model_type: Type of model to train
        **model_params: Additional model parameters

    Returns:
        Trained model
    """
    print(f"🚀 Training {model_type} model...")

    {% if model_type == 'classification' %}
    if model_type == "random_forest":
        model = RandomForestClassifier(**model_params)
    elif model_type == "logistic_regression":
        model = LogisticRegression(**model_params)
    else:
        raise ValueError(f"Unknown model type: {model_type}")
    {% elif model_type == 'regression' %}
    if model_type == "random_forest":
        model = RandomForestRegressor(**model_params)
    elif model_type == "linear_regression":
        model = LinearRegression(**model_params)
    else:
        raise ValueError(f"Unknown model type: {model_type}")
    {% elif model_type == 'clustering' %}
    if model_type == "kmeans":
        model = KMeans(**model_params)
    else:
        raise ValueError(f"Unknown model type: {model_type}")
    {% endif %}

    # Train model
    model.fit(X_train, y_train)

    print(f"✓ Model trained successfully")
    return model


def save_model(model, model_path: str | Path = "models/model.joblib") -> None:
    """Save trained model to disk

    Args:
        model: Trained model
        model_path: Path to save model
    """
    model_path = Path(model_path)
    model_path.parent.mkdir(parents=True, exist_ok=True)

    joblib.dump(model, model_path)
    print(f"✓ Model saved to {model_path}")


{% if use_hydra %}
@hydra.main(version_base=None, config_path="../../configs", config_name="config")
def main(cfg: DictConfig) -> None:
    """Main training pipeline"""
    print("🎸 Starting training...")

    {% if use_wandb %}
    # Initialize W&B
    wandb.init(
        project="{{ project_slug }}",
        job_type="training",
        config=dict(cfg.model)
    )
    {% endif %}

    # Load data
    X_train = pd.read_parquet(cfg.data.processed_path + "/X_train.parquet")
    y_train = pd.read_parquet(cfg.data.processed_path + "/y_train.parquet")["target"]

    # Train model
    model = train_model(
        X_train,
        y_train,
        model_type=cfg.model.type,
        **cfg.model.params
    )

    # Save model
    save_model(model, cfg.model.save_path)

    {% if use_wandb %}
    # Log model
    wandb.log_model(path=cfg.model.save_path, name="model")
    wandb.finish()
    {% endif %}

    print("✓ Training complete!")
