[project]
name = "{{ project_slug }}"
version = "0.1.0"
description = "{{ project_description }}"
authors = [
    {name = "{{ author_name }}", email = "{{ author_email }}"}
]
readme = "README.md"
requires-python = ">={{ python_version }}"
license = {text = "{{ license }}"}

dependencies = [
    "numpy>=1.26.0",
    "pandas>=2.1.0",
    "scikit-learn>=1.3.0",
    "matplotlib>=3.8.0",
    "seaborn>=0.13.0",
    {% if use_hydra %}"hydra-core>=1.3.0",{% endif %}
    {% if use_wandb %}"wandb>=0.16.0",{% endif %}
    {% if use_marimo %}"marimo>=0.1.0",{% endif %}
]

[project.optional-dependencies]
dev = [
    "pytest>=7.4.0",
    "pytest-cov>=4.1.0",
    "ruff>=0.1.0",
    "mypy>=1.7.0",
    {% if use_precommit %}"pre-commit>=3.5.0",{% endif %}
]

{% if dataset_source == 'kaggle' %}
kaggle = [
    "kaggle>=1.5.0",
]
{% endif %}

{% if dataset_source == 'huggingface' %}
huggingface = [
    "datasets>=2.14.0",
]
{% endif %}

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.ruff]
line-length = 100
target-version = "py{{ python_target }}"

[tool.ruff.lint]
select = ["E", "F", "I", "N", "W", "UP", "B", "SIM"]

[tool.pytest.ini_options]
testpaths = ["tests"]
python_files = ["test_*.py"]
addopts = "-v --strict-markers"
