#++++++++++++++++++++++++++++++++
# {{ project_name }} - ML Pipeline
#++++++++++++++++++++++++++++++++

# Show available commands
default:
    @just --list

# Setup development environment
setup:
    @echo "Setting up {{ project_name }}..."
    {% if package_manager == 'uv' %}uv sync{% else %}poetry install{% endif %}
    {% if use_precommit %}{% if package_manager == 'uv' %}uv run {% endif %}pre-commit install{% endif %}
    @echo "✓ Setup complete!"

# Install dependencies
install:
    {% if package_manager == 'uv' %}uv sync{% else %}poetry install{% endif %}

# Download/prepare data
data:
    @echo "📊 Preparing data..."
    {% if package_manager == 'uv' %}uv run {% endif %}python src/{{ python_module }}/data/prepare_data.py
    @echo "✓ Data prepared"

# Run data pipeline (download, clean, split)
data-pipeline:
    @echo "🔄 Running data pipeline..."
    just data
    @echo "✓ Data pipeline complete"

# Train model
train:
    @echo "Training model..."
    {% if package_manager == 'uv' %}uv run {% endif %}python src/{{ python_module }}/models/train.py
    @echo "✓ Model trained"

# Evaluate model
evaluate:
    @echo "Evaluating model..."
    {% if package_manager == 'uv' %}uv run {% endif %}python src/{{ python_module }}/models/evaluate.py
    @echo "✓ Model evaluated"

# Make predictions
predict:
    @echo "Making predictions..."
    {% if package_manager == 'uv' %}uv run {% endif %}python src/{{ python_module }}/models/predict.py
    @echo "✓ Predictions complete"

{% if use_marimo %}
# Start Marimo notebook
notebook:
    {% if package_manager == 'uv' %}uv run {% endif %}marimo edit notebooks/explore.py
{% endif %}

# Format code
format:
    {% if package_manager == 'uv' %}uv run {% endif %}ruff format .
    @echo "✓ Code formatted"

# Lint code
lint:
    {% if package_manager == 'uv' %}uv run {% endif %}ruff check .

# Fix all issues
fix:
    {% if package_manager == 'uv' %}uv run {% endif %}ruff format .
    {% if package_manager == 'uv' %}uv run {% endif %}ruff check --fix .
    @echo "✓ Issues fixed"

# Run tests
test:
    {% if package_manager == 'uv' %}uv run {% endif %}pytest tests/ -v

# Run tests with coverage
test-cov:
    {% if package_manager == 'uv' %}uv run {% endif %}pytest tests/ --cov=src --cov-report=html
    @echo "✓ Coverage report: htmlcov/index.html"

# Clean artifacts
clean:
    rm -rf __pycache__ .pytest_cache .ruff_cache
    find . -type f -name "*.pyc" -delete
    find . -type d -name "__pycache__" -delete
    @echo "✓ Cleaned"

# Full pipeline (data + train + evaluate)
pipeline: data-pipeline train evaluate
    @echo "✓ Full pipeline complete!"

# Show project info
info:
    @echo " {{ project_name }}"
    @echo "Model type: {{ model_type }}"
    @echo "Python: {{ python_version }}"
    @echo "Package manager: {{ package_manager }}"
