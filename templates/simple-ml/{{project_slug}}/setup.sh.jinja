#!/usr/bin/env bash
# {{ project_name }} Setup Script

set -e

echo "Setting up {{ project_name }}..."
echo ""

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
NC='\033[0m'

# Check tools
echo "Checking required tools..."
{% if package_manager == 'uv' %}
if ! command -v uv &> /dev/null; then
    echo -e "${RED}✗ UV not found${NC}"
    echo "Install: curl -LsSf https://astral.sh/uv/install.sh | sh"
    exit 1
fi
echo -e "${GREEN}✓${NC} UV found"
{% else %}
if ! command -v poetry &> /dev/null; then
    echo -e "${RED}✗ Poetry not found${NC}"
    echo "Install: curl -sSL https://install.python-poetry.org | python3 -"
    exit 1
fi
echo -e "${GREEN}✓${NC} Poetry found"
{% endif %}

echo ""

# Install dependencies
echo "Installing dependencies..."
{% if package_manager == 'uv' %}
uv sync
{% else %}
poetry install
{% endif %}
echo -e "${GREEN}✓${NC} Dependencies installed"
echo ""

{% if use_precommit %}
# Install pre-commit hooks
echo "Installing pre-commit hooks..."
{% if package_manager == 'uv' %}uv run {% endif %}pre-commit install
echo -e "${GREEN}✓${NC} Pre-commit hooks installed"
echo ""
{% endif %}

# Create data directories
echo "Creating data directories..."
mkdir -p data/{raw,processed,interim}
mkdir -p models
touch data/raw/.gitkeep data/processed/.gitkeep data/interim/.gitkeep models/.gitkeep
echo -e "${GREEN}✓${NC} Directories created"
echo ""

# Success
echo -e "${GREEN}✓ Setup complete!${NC}"
echo ""
echo "Next steps:"
echo "  just data       # Prepare data"
echo "  just train      # Train model"
echo "  just evaluate   # Evaluate model"
echo ""
echo " Rawk your ML project! ⚡"
